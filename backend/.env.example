# ===================================================
# WARSGATE AUTOMATION BOM Backend - Environment Config
# ===================================================

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# -- For local dev, use a local PostgreSQL or free Render DB --
DATABASE_URL="postgresql://postgres:password@localhost:5432/warsgate_bom"

# Server Port
PORT=5000

# Frontend Origin (for CORS)
FRONTEND_URL="http://localhost:3000"

# ===================================================
# FOR PRODUCTION ON RENDER.COM, set these in the
# Render dashboard under "Environment Variables":
# DATABASE_URL  = (copied from Render PostgreSQL)
# FRONTEND_URL  = https://your-frontend.onrender.com
# ===================================================
